# FastAPI base URL (used by every authenticated request).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Demo mode is OPT-IN. Leave false for real Supabase + FastAPI; set true only for a
# standalone showcase build that uses mock data and in-memory identities.
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
