APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://credix:credix@localhost:5432/credix
CORS_ORIGINS=http://localhost:3000

# Supabase Auth public project configuration. No service-role key is needed for
# FastAPI user-token verification: asymmetric user JWTs are verified via JWKS.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
STORAGE_BUCKET=

# DEMO/LEGACY ONLY: enables the unauthenticated POST /auth/login. Keep false anywhere real users exist.
ENABLE_LEGACY_LOGIN=false
# In production (APP_ENV=production) the app refuses to start without SUPABASE_URL,
# with ENABLE_LEGACY_LOGIN=true, or with a SQLite DATABASE_URL.
