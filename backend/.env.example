APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://credix:credix@localhost:5432/credix
CORS_ORIGINS=http://localhost:3000

# Supabase Auth public project configuration. No service-role key is needed for
# FastAPI user-token verification: asymmetric user JWTs are verified via JWKS.
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
STORAGE_BUCKET=

# AI Assistant runtime. Use ``cpu`` or ``auto`` on Vercel/CPU hosts; reserve
# ``cuda`` for a host with a verified NVIDIA runtime and the pinned model.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
CREDIX_RERANKER_DEVICE=auto
